# Writes tsnet_capver.h. CAPVER is the capability version the client
# implements; when TAILCFG points at a tailscale/tailcfg/tailcfg.go checkout,
# CurrentCapabilityVersion is read from it instead.
#   cmake -DCAPVER=<n> [-DTAILCFG=<tailcfg.go>] -DOUT=<tsnet_capver.h> -P gen-capver.cmake

set(capver "${CAPVER}")
if (TAILCFG)
    if (NOT EXISTS "${TAILCFG}")
        message(FATAL_ERROR "gen-capver: ${TAILCFG} not found")
    endif ()
    file(STRINGS "${TAILCFG}" capver_line
         REGEX "^const CurrentCapabilityVersion CapabilityVersion = [0-9]+")
    if (NOT capver_line)
        message(FATAL_ERROR "gen-capver: CurrentCapabilityVersion not found in ${TAILCFG}")
    endif ()
    string(REGEX MATCH "[0-9]+" capver "${capver_line}")
endif ()
if (NOT capver MATCHES "^[0-9]+$")
    message(FATAL_ERROR "gen-capver: invalid capability version '${capver}'")
endif ()

file(WRITE "${OUT}" "/* Generated by tsnet/cmake/gen-capver.cmake. Do not edit. */
#ifndef TSNET_CAPVER_H
#define TSNET_CAPVER_H
#define TSNET_CAPABILITY_VERSION ${capver}
#endif
")
message(STATUS "gen-capver: CurrentCapabilityVersion = ${capver}")
